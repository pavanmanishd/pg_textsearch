-- Test explicit index name in to_bm25query
-- Validates fixes for GitHub issues #183 and #194
CREATE EXTENSION IF NOT EXISTS pg_textsearch;
-----------------------------------------------------------------------
-- Issue #194: to_bm25query with explicit index ignores index column
-- Using an index on a different column should error
-----------------------------------------------------------------------
-- Create table with TWO text columns
CREATE TABLE explicit_index_test (
    id SERIAL PRIMARY KEY,
    title TEXT,
    content TEXT
);
-- Index on 'content' column only
CREATE INDEX content_idx ON explicit_index_test USING bm25 (content)
    WITH (text_config = 'english');
NOTICE:  BM25 index build started for relation content_idx
NOTICE:  Using text search configuration: english
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 0 documents, avg_length=0.00
-- Insert test data
INSERT INTO explicit_index_test (title, content) VALUES
    ('rust c java', 'postgres mysql'),
    ('python ruby', 'redis mongodb');
-- This should ERROR: using content_idx to search 'title' column
-- The index is on 'content' but we're searching 'title'
SELECT * FROM explicit_index_test
    ORDER BY title <@> to_bm25query('postgres', 'content_idx');
ERROR:  index "content_idx" is not on column "title"
DETAIL:  The explicitly specified index is not built on the column being searched.
HINT:  Use an index that is built on column "title" of table "explicit_index_test", or omit the index name to use automatic index resolution.
-- Positive test: using correct column should work
SELECT id, content <@> to_bm25query('postgres', 'content_idx') AS score
FROM explicit_index_test
ORDER BY score
LIMIT 10;
 id |        score        
----+---------------------
  1 | -0.6931471824645996
(1 row)

-- This should ERROR: left operand is a constant, not a column
SELECT 'hello' <@> to_bm25query('postgres', 'content_idx') AS score;
ERROR:  left operand of <@> must reference a table column
HINT:  Use column_name <@> bm25query, not a constant.
-- Clean up
DROP TABLE explicit_index_test;
-----------------------------------------------------------------------
-- Issue #183: to_bm25query with explicit index name does not force
-- planner to use that index
-----------------------------------------------------------------------
-- Create table
CREATE TABLE multi_index_test (
    id SERIAL PRIMARY KEY,
    category_id INT,
    content TEXT
);
-- Insert test data - enough rows to make planner consider index choices
INSERT INTO multi_index_test (category_id, content)
SELECT
    (i % 10),
    'Les ressources humaines gèrent les employés et leurs contrats de travail'
FROM generate_series(1, 1000) i;
-- Create two BM25 indexes with different text configurations on same column
CREATE INDEX content_idx_french ON multi_index_test USING bm25 (content)
    WITH (text_config = 'french');
NOTICE:  BM25 index build started for relation content_idx_french
NOTICE:  Using text search configuration: french
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 1000 documents, avg_length=9.00
CREATE INDEX content_idx_simple ON multi_index_test USING bm25 (content)
    WITH (text_config = 'simple');
NOTICE:  BM25 index build started for relation content_idx_simple
NOTICE:  Using text search configuration: simple
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 1000 documents, avg_length=11.00
-- Analyze for statistics
ANALYZE multi_index_test;
-- Query explicitly requesting the French index
-- The planner should use content_idx_french as specified
EXPLAIN (COSTS OFF)
SELECT id, content <@> to_bm25query('ressources', 'content_idx_french') AS score
FROM multi_index_test
WHERE category_id = 1
ORDER BY score
LIMIT 10;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Limit
   ->  Index Scan using content_idx_french on multi_index_test
         Order By: (content <@> 'content_idx_french:ressources'::bm25query)
         Filter: (category_id = 1)
(4 rows)

-- The same with the index name as a parameter. A custom plan folds
-- to_bm25query() to a constant after the explicit index was collected, so
-- index costing has to choose the named index.
SET plan_cache_mode = force_custom_plan;
PREPARE explicit_by_index(text, text) AS
SELECT ROUND((content <@> to_bm25query($1, $2))::numeric, 4) AS score
FROM multi_index_test
ORDER BY content <@> to_bm25query($1, $2)
LIMIT 2;
EXPLAIN (COSTS OFF)
EXECUTE explicit_by_index('ressources', 'content_idx_french');
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Limit
   ->  Index Scan using content_idx_french on multi_index_test
         Order By: (content <@> 'content_idx_french:ressources'::bm25query)
(3 rows)

EXECUTE explicit_by_index('ressources', 'content_idx_french');
  score  
---------
 -0.0005
 -0.0005
(2 rows)

EXPLAIN (COSTS OFF)
EXECUTE explicit_by_index('ressources', 'content_idx_simple');
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Limit
   ->  Index Scan using content_idx_simple on multi_index_test
         Order By: (content <@> 'content_idx_simple:ressources'::bm25query)
(3 rows)

EXECUTE explicit_by_index('ressources', 'content_idx_simple');
  score  
---------
 -0.0005
 -0.0005
(2 rows)

DEALLOCATE explicit_by_index;
-- Two indexes on a partitioned table: the partition indexes of the named
-- parent index must be scanned
CREATE TABLE multi_index_part (id int, content text) PARTITION BY RANGE (id);
CREATE TABLE multi_index_part_1 PARTITION OF multi_index_part
    FOR VALUES FROM (0) TO (1000);
INSERT INTO multi_index_part
SELECT i, 'Les ressources humaines gèrent les employés'
FROM generate_series(1, 200) i;
CREATE INDEX multi_part_french ON multi_index_part USING bm25 (content)
    WITH (text_config = 'french');
NOTICE:  BM25 index build started for relation multi_index_part_1_content_idx
NOTICE:  Using text search configuration: french
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 200 documents, avg_length=6.00
CREATE INDEX multi_part_simple ON multi_index_part USING bm25 (content)
    WITH (text_config = 'simple');
NOTICE:  BM25 index build started for relation multi_index_part_1_content_idx1
NOTICE:  Using text search configuration: simple
NOTICE:  Using index options: k1=1.20, b=0.75
NOTICE:  BM25 index build completed: 200 documents, avg_length=6.00
ANALYZE multi_index_part;
PREPARE explicit_part_by_index(text, text) AS
SELECT id FROM multi_index_part
ORDER BY content <@> to_bm25query($1, $2)
LIMIT 2;
EXPLAIN (COSTS OFF)
EXECUTE explicit_part_by_index('ressources', 'multi_part_french');
                                          QUERY PLAN                                          
----------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using multi_index_part_1_content_idx on multi_index_part_1 multi_index_part
         Order By: (content <@> 'multi_part_french:ressources'::bm25query)
(3 rows)

EXPLAIN (COSTS OFF)
EXECUTE explicit_part_by_index('ressources', 'multi_part_simple');
                                          QUERY PLAN                                           
-----------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using multi_index_part_1_content_idx1 on multi_index_part_1 multi_index_part
         Order By: (content <@> 'multi_part_simple:ressources'::bm25query)
(3 rows)

DEALLOCATE explicit_part_by_index;
DROP TABLE multi_index_part;
RESET plan_cache_mode;
-- Positive test: without an explicit index, implicit resolution still
-- works. All matching rows share the same text, so the BM25 scores are
-- deterministic even though the tied tuple ids (and which tied index is
-- scanned) are not.
SET client_min_messages = error;
\pset format unaligned
SELECT content <@> 'ressources' AS score
FROM multi_index_test
WHERE category_id = 1
ORDER BY score
LIMIT 3;
score
-0.0004996252828277647
-0.0004996252828277647
-0.0004996252828277647
(3 rows)
\pset format aligned
RESET client_min_messages;
-- Positive test: explicit index matching the scanned index works
-- Drop the simple index so french is the only choice
DROP INDEX content_idx_simple;
EXPLAIN (COSTS OFF)
SELECT id, content <@> to_bm25query('ressources', 'content_idx_french') AS score
FROM multi_index_test
WHERE category_id = 1
ORDER BY score
LIMIT 10;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Limit
   ->  Index Scan using content_idx_french on multi_index_test
         Order By: (content <@> 'content_idx_french:ressources'::bm25query)
         Filter: (category_id = 1)
(4 rows)

-- Clean up
DROP TABLE multi_index_test;
DROP EXTENSION pg_textsearch CASCADE;
